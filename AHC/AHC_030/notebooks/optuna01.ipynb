   "source": [
    "import subprocess\n",
    "\n",
    "\n",
    "proc = subprocess.Popen([\"../a.exe\", \"1.1\", \"1.1\"], stdout=subprocess.PIPE)\n",
    "\n",
    "for line in proc.stdout: #1行ずつ標準出力を得る\n",
    "    print(line.decode('utf-8')) # byteからutf-8にデコード\n",
    "\n",
    "proc.wait() #プロセスが終わるまで待つ\n",
    "print(proc.returncode) #戻り値"
   ]
  }
 ],
