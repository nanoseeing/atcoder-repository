{
  "tasks": [
    {
      "type": "cppbuild",
      "label": "C++ default build",
      "command": "/usr/bin/g++",
      "args": [
        "-std=gnu++20",
        "-g2",
        "-I/home/nanoseeing/AtCoder/ac-library-master",
        "-I/home/nanoseeing/AtCoder/cpp-dump",
        "-I/usr/include/boost/lib",
        "-Wall",
        "-Wextra",
        "-Wno-unused-variable",
        "-fdiagnostics-color=always", //警告をカラー表示
        "-fsanitize=address,undefined", // 配列外参照,未定義動作（オーバーフローなど）
        "${file}",
        "-o",
        "${fileDirname}/a.out"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "type": "cppbuild",
      "label": "C++ debug build",
      "command": "/usr/bin/g++",
      "args": [
        "-std=gnu++20",
        "-g2",
        "-I/home/nanoseeing/AtCoder/ac-library-master",
        "-I/home/nanoseeing/AtCoder/cpp-dump",
        "-I/usr/include/boost/lib",
        "-Wall",
        "-Wextra",
        "-Wno-unused-variable",
        "-fdiagnostics-color=always", //警告をカラー表示
        "${file}",
        "-o",
        "${fileDirname}/a.out"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "type": "cppbuild",
      "label": "C++ release build",
      "command": "/usr/bin/g++",
      "args": [
        "-std=gnu++20",
        "-O2",
        "-I/home/nanoseeing/AtCoder/ac-library-master",
        "-I/home/nanoseeing/AtCoder/cpp-dump",
        "-I/usr/include/boost/lib",
        "-Wall",
        "-Wextra",
        "-Wno-unused-variable",
        "-mtune=native",
        "-march=native",
        "-fdiagnostics-color=always", //警告をカラー表示
        "${file}",
        "-o",
        "${fileDirname}/a.out"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": false
      }
    }
  ]
}
